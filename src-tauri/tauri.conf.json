{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoniQA",
  "version": "0.1.0",
  "identifier": "com.moniqa.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MoniQA",
        "width": 320,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "url": "/"
      },
      {
        "label": "dashboard",
        "title": "MoniQA — System Monitor",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "resizable": true,
        "url": "/dashboard/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
