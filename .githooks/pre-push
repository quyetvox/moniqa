#!/usr/bin/env bash
set -euo pipefail

# Skip when invoked by the hook itself
if [ "${MONIQA_RELEASE_PUSH:-0}" = "1" ]; then
  exit 0
fi

remote="$1"
zero_sha="0000000000000000000000000000000000000000"
pushing_main=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_ref" = "refs/heads/main" ] && [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "$zero_sha" ] && [ "$local_sha" != "$remote_sha" ]; then
    pushing_main=1
  fi
done

# Only auto-bump when pushing new commits to main
if [ "$pushing_main" -ne 1 ]; then
  exit 0
fi

# If HEAD is already tagged with a release tag, push normally without bumping again
if git tag --points-at HEAD | grep -q '^v'; then
  exit 0
fi

# Avoid accidentally committing unrelated staged changes
if ! git diff --cached --quiet; then
  echo "pre-push: staged changes detected. Commit or unstage them before pushing to main." >&2
  exit 1
fi

next_version="$(node -e '
const fs = require("fs");
const confPath = "src-tauri/tauri.conf.json";
const conf = JSON.parse(fs.readFileSync(confPath, "utf8"));
const parts = String(conf.version).split(".").map(Number);
if (parts.length !== 3 || parts.some(Number.isNaN)) {
  console.error("Invalid semver version in " + confPath + ": " + conf.version);
  process.exit(1);
}
parts[2] += 1;
const next = parts.join(".");
conf.version = next;
fs.writeFileSync(confPath, JSON.stringify(conf, null, 2) + "\n");

const pkgPath = "package.json";
const pkg = JSON.parse(fs.readFileSync(pkgPath, "utf8"));
pkg.version = next;
fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2) + "\n");

const cargoPath = "src-tauri/Cargo.toml";
const cargo = fs.readFileSync(cargoPath, "utf8");
const updatedCargo = cargo.replace(/^(version\s*=\s*")[^"]+(")/m, `$1${next}$2`);
if (cargo === updatedCargo) {
  console.error("Failed to update version in " + cargoPath);
  process.exit(1);
}
fs.writeFileSync(cargoPath, updatedCargo);

process.stdout.write(next);
')"

tag="v$next_version"

if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  echo "pre-push: tag $tag already exists." >&2
  git checkout -- src-tauri/tauri.conf.json package.json src-tauri/Cargo.toml
  exit 1
fi

git commit --only src-tauri/tauri.conf.json package.json src-tauri/Cargo.toml -m "chore(release): $tag"
git tag -a "$tag" -m "Release $tag"

echo "pre-push: auto-bumped to $tag, pushing main and tag $tag to $remote..."
MONIQA_RELEASE_PUSH=1 git push --no-verify "$remote" "refs/heads/main:refs/heads/main" "refs/tags/$tag"

echo "pre-push: done! $tag has been pushed (ignore the outer git push abort message below)."
exit 1
